{
  "mcpServers": {
    "daodao-pg-prod": {
      "command": "node",
      "args": ["${DAODAO_MCP_DIR}/packages/pg/dist/server.js"],
      "env": {
        "DATABASE_URL": "${DAODAO_PG_PROD_URL}",
        "SSH_TUNNEL": "daodao:5433:127.0.0.1:15432"
      }
    },
    "daodao-pg-dev": {
      "command": "node",
      "args": ["${DAODAO_MCP_DIR}/packages/pg/dist/server.js"],
      "env": {
        "DATABASE_URL": "${DAODAO_PG_DEV_URL}",
        "DAODAO_MCP_SKIP_ROLE_CHECK": "1",
        "SSH_TUNNEL": "daodao:5424:localhost:5423"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer $NOTION_TOKEN\", \"Notion-Version\": \"2022-06-28\"}"
      }
    }
  }
}
