{
  "description": "GENERATED by plugin/scripts/build.ts — 不要直接改這個檔案，改 plugin/skills/<name>/ 後重跑 pnpm plugin:build",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/plugin/hooks/session-start.sh\"",
            "commandWindows": "python -X utf8 -c \"import runpy,subprocess; runpy.run_path(subprocess.check_output(['git','rev-parse','--show-toplevel'],encoding='utf-8').strip()+'/plugin/hooks/run-windows.py',run_name='__main__')\" session-start.sh; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/plugin/hooks/pre-write-guard.sh\"",
            "commandWindows": "python -X utf8 -c \"import runpy,subprocess; runpy.run_path(subprocess.check_output(['git','rev-parse','--show-toplevel'],encoding='utf-8').strip()+'/plugin/hooks/run-windows.py',run_name='__main__')\" pre-write-guard.sh; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/plugin/hooks/test-integrity-guard.py\"",
            "commandWindows": "python -X utf8 -c \"import runpy,subprocess; runpy.run_path(subprocess.check_output(['git','rev-parse','--show-toplevel'],encoding='utf-8').strip()+'/plugin/hooks/run-windows.py',run_name='__main__')\" test-integrity-guard.py; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/plugin/hooks/pre-pr-gate.sh\"",
            "commandWindows": "python -X utf8 -c \"import runpy,subprocess; runpy.run_path(subprocess.check_output(['git','rev-parse','--show-toplevel'],encoding='utf-8').strip()+'/plugin/hooks/run-windows.py',run_name='__main__')\" pre-pr-gate.sh; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/plugin/hooks/post-write-format.sh\"",
            "commandWindows": "python -X utf8 -c \"import runpy,subprocess; runpy.run_path(subprocess.check_output(['git','rev-parse','--show-toplevel'],encoding='utf-8').strip()+'/plugin/hooks/run-windows.py',run_name='__main__')\" post-write-format.sh; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/plugin/hooks/quiet-stop.py\"",
            "timeout": 10000,
            "commandWindows": "python -X utf8 -c \"import runpy,subprocess; runpy.run_path(subprocess.check_output(['git','rev-parse','--show-toplevel'],encoding='utf-8').strip()+'/plugin/hooks/run-windows.py',run_name='__main__')\" quiet-stop.py; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
